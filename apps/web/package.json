{
	"name": "@j-os/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n ui,db -c blue,magenta \"bun run dev:ui\" \"bun run dev:db\"",
		"dev:ui": "vite",
		"dev:db": "convex dev",
		"open:db": "bunx convex dashboard",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"icons:gen": "bun scripts/gen-icons.mjs",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"lint": "bun run lint:logic && bun run lint:style",
		"lint:logic": "eslint \"src/**/*.{ts,tsx}\" \"convex/**/*.ts\" \"emails/**/*.{ts,tsx}\" \"agreements/**/*.ts\" --cache --max-warnings 0",
		"lint:style": "stylelint \"src/**/*.scss\" --cache --allow-empty-input --max-warnings 0",
		"lint:style:ci": "bun run lint:style --custom-formatter @csstools/stylelint-formatter-github",
		"format": "prettier --write \"{src,convex,emails,agreements}/**/*.{ts,tsx,css,scss}\" --ignore-path ../../.prettierignore",
		"email:logo": "bun emails/rasterize-logo.ts",
		"email:build": "bun emails/build.ts",
		"email:check": "bun emails/build.ts --check",
		"agreements:build": "bun agreements/build.ts",
		"agreements:check": "bun agreements/build.ts --check",
		"agreements:test-sign": "bun agreements/test-sign.ts",
		"lifecycle:diagram": "bun scripts/lifecycleDiagram.ts"
	},
	"prettier": "@j-os/config-prettier",
	"dependencies": {
		"@ark-ui/solid": "catalog:",
		"@casl/ability": "^7.0.0",
		"@convex-dev/better-auth": "^0.12.2",
		"@convex-dev/rate-limiter": "^0.3.2",
		"@internationalized/date": "^3.12.0",
		"@j-os/design-system": "workspace:*",
		"@pdf-lib/fontkit": "^1.1.1",
		"@signpdf/placeholder-plain": "^3.3.0",
		"@signpdf/signer-p12": "^3.3.0",
		"@signpdf/signpdf": "^3.3.0",
		"@solidjs/router": "catalog:",
		"@tanstack/solid-hotkeys": "catalog:",
		"@thisbeyond/solid-dnd": "^0.7.5",
		"better-auth": "1.6.11",
		"convex": "catalog:",
		"convex-solidjs": "catalog:",
		"node-forge": "^1.4.0",
		"pdf-lib": "^1.17.1",
		"solid-js": "catalog:",
		"web-push": "^3.6.7",
		"workbox-window": "^7.4.1"
	},
	"devDependencies": {
		"@csstools/stylelint-formatter-github": "^2.0.0",
		"@edge-runtime/vm": "^5.0.0",
		"@j-os/config-eslint": "workspace:*",
		"@j-os/config-prettier": "workspace:*",
		"@j-os/config-stylelint": "workspace:*",
		"@solidjs/testing-library": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@types/node": "^25.9.1",
		"@types/node-forge": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/web-push": "^3.6.4",
		"concurrently": "^9.2.1",
		"convex-test": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-solid": "catalog:",
		"happy-dom": "catalog:",
		"jsx-email": "^3.2.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sass": "catalog:",
		"sharp": "^0.35.1",
		"solid-devtools": "^0.34.5",
		"stylelint": "catalog:",
		"typescript": "catalog:",
		"unpdf": "^1.8.1",
		"vite": "catalog:",
		"vite-plugin-pwa": "catalog:",
		"vite-plugin-solid": "catalog:",
		"vitest": "catalog:"
	}
}

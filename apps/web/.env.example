# Convex (filled in by `bunx convex dev`)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# reCAPTCHA v3 for the public /sign-up page.
# Site key is public (shipped to the browser by Vite).
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
# Secret key is server-side. It is NOT read from this file — set it on the Convex
# deployment so the submitApplication action can read process.env.RECAPTCHA_SECRET:
#   bunx convex env set RECAPTCHA_SECRET <your-recaptcha-v3-secret-key>

# Email in development (server-side, set on the Convex dev deployment):
#   bunx convex env set EMAIL_DEV_LOG 1
# With no RESEND_API_KEY, this logs each email's dev line (including the
# magic-link sign-in URL) to the Convex logs. Never set it on prod.

# Google Safe Browsing (server-side, set on the Convex deployment):
#   bunx convex env set SAFE_BROWSING_API_KEY <key>
# Unset → applicant links are not reputation-checked.

# Web Push public VAPID key, shipped to the browser (pairs with the Convex VAPID_* env vars).
VITE_VAPID_PUBLIC_KEY=

{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		"apps/web": {
			"entry": [
				"emails/templates/*.tsx",
				"eslint/fixtures/*.{ts,tsx}",
				"vitest.stryker.config.ts"
			]
		},
		"apps/landing-page": {
			"entry": [
				"src/entry-server.tsx"
			]
		},
		"packages/design-system": {
			"ignore": [
				"scripts/morph-probe.js"
			],
			"ignoreDependencies": [
				"@fontsource-variable/material-symbols-sharp"
			]
		},
		"packages/config-vite": {
			"ignoreIssues": {
				"baseConfig.js": [
					"duplicates"
				],
				"baseConfig.d.ts": [
					"duplicates"
				]
			}
		}
	},
	"ignoreBinaries": [
		"typst"
	],
	"ignoreDependencies": [
		"@csstools/stylelint-formatter-github"
	]
}

{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "es5",
	"printWidth": 80,
	"sortPackageJson": true,
	"ignorePatterns": [
		"**/convex/emails/generated/",
		"**/convex/agreements/generated/",
		"**/convex/_generated/",
		"**/dist/"
	]
}
